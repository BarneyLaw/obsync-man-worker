{
  "_comment": "Shared contract between internal/policy (Go) and plugin/src/policy.ts. Both test suites load this file. Change the engine, change this, run both.",
  "policy": {
    "version": 1,
    "default": "include",
    "rules": [
      { "name": "no-video", "priority": 10, "action": "skip",
        "match": { "ext": ["mp4", "mkv", "mov", "avi", "webm"] } },
      { "name": "hard-size-cap", "priority": 10, "action": "skip",
        "match": { "min_size": 2147483648 } },
      { "name": "keep-slides", "priority": 100, "action": "include",
        "match": { "ext": ["pdf", "pptx"] } },
      { "name": "drop-solutions", "priority": 50, "action": "skip",
        "match": { "glob": ["*/solutions/*"] } }
    ]
  },
  "cases": [
    { "candidate": { "Path": "notes.md", "Size": 1024, "MIME": "text/markdown", "CourseID": 1 }, "want": "include", "want_rule": "" },
    { "candidate": { "Path": "w1/lecture.mp4", "Size": 104857600, "MIME": "video/mp4", "CourseID": 1 }, "want": "skip", "want_rule": "no-video" },
    { "candidate": { "Path": "w1/lecture.MP4", "Size": 104857600, "MIME": "video/mp4", "CourseID": 1 }, "want": "skip", "want_rule": "no-video" },
    { "candidate": { "Path": "big.zip", "Size": 3221225472, "MIME": "application/zip", "CourseID": 1 }, "want": "skip", "want_rule": "hard-size-cap" },
    { "candidate": { "Path": "textbook.pdf", "Size": 3221225472, "MIME": "application/pdf", "CourseID": 1 }, "want": "include", "want_rule": "keep-slides" },
    { "candidate": { "Path": "cs/solutions/a.docx", "Size": 2048, "MIME": "", "CourseID": 1 }, "want": "skip", "want_rule": "drop-solutions" },
    { "candidate": { "Path": "cs/solutions/a.pdf", "Size": 2048, "MIME": "", "CourseID": 1 }, "want": "include", "want_rule": "keep-slides" },
    { "candidate": { "Path": "LICENSE", "Size": 10, "MIME": "", "CourseID": 1 }, "want": "include", "want_rule": "" },
    { "candidate": { "Path": ".gitignore", "Size": 10, "MIME": "", "CourseID": 1 }, "want": "include", "want_rule": "" }
  ]
}
